---
import type { Project } from "../data/profile";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="group relative p-5 rounded-lg border border-line-light dark:border-line-dark bg-paper dark:bg-ink hover:bg-paper-raised/40 dark:hover:bg-ink-raised/40 transition-colors">
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1">
      <div class="flex flex-wrap items-center gap-2 mb-1.5">
        <span class="font-mono text-[0.7rem] uppercase tracking-wider text-signal-dim dark:text-signal">
          {project.category}
        </span>
        {project.badge && (
          <span class="font-mono text-[0.65rem] px-1.5 py-0.5 rounded bg-signal/10 text-signal-dim dark:text-signal border border-signal/20">
            {project.badge}
          </span>
        )}
      </div>
      <h3 class="font-display font-medium text-lg text-text-light dark:text-text-dark group-hover:text-signal-dim dark:group-hover:text-signal transition-colors">
        {project.link ? (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 focus:outline-none"
          >
            {project.title}
            <span class="text-xs opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
          </a>
        ) : (
          project.title
        )}
      </h3>
    </div>
  </div>

  <p class="mt-2.5 text-sm leading-relaxed text-text-light-dim dark:text-text-dark-dim">
    {project.summary}
  </p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {project.tech.map((t) => (
      <span class="font-mono text-[0.65rem] tracking-wide px-2 py-0.5 rounded border border-line-light dark:border-line-dark text-text-light-dim dark:text-text-dark-dim bg-paper-raised dark:bg-ink-raised">
        {t}
      </span>
    ))}
  </div>
</div>
