---
import { SKILLS } from "../data/profile";
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
  {
    SKILLS.map((cat) => (
      <div class="p-4 rounded-lg border border-line-light dark:border-line-dark bg-paper dark:bg-ink">
        <h3 class="font-mono text-xs uppercase tracking-wider text-signal-dim dark:text-signal mb-3">
          {cat.name}
        </h3>
        <div class="flex flex-wrap gap-1.5">
          {cat.items.map((skill) => (
            <span class="font-mono text-xs px-2 py-1 rounded border border-line-light dark:border-line-dark text-text-light dark:text-text-dark bg-paper-raised dark:bg-ink-raised">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>
