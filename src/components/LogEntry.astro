---
import type { LogEntry } from "../data/profile";

interface Props {
  entry: LogEntry;
}
const { entry } = Astro.props;
---

<div class="grid grid-cols-[7.5rem_1fr] sm:grid-cols-[9rem_1fr] gap-4 py-5 border-b border-line-light dark:border-line-dark last:border-none">
  <div class="font-mono text-xs text-signal-dim dark:text-signal pt-1">
    {entry.date}
  </div>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-2">
      <h3 class="font-display font-medium text-base">{entry.title}</h3>
      <span class="text-text-light-dim dark:text-text-dark-dim text-sm">— {entry.org}</span>
    </div>
    <p class="mt-1.5 text-sm leading-relaxed text-text-light-dim dark:text-text-dark-dim">
      {entry.summary}
    </p>
    {
      entry.tags && entry.tags.length > 0 && (
        <div class="mt-2.5 flex flex-wrap gap-1.5">
          {entry.tags.map((tag) => (
            <span class="font-mono text-[0.65rem] uppercase tracking-wide px-1.5 py-0.5 rounded border border-line-light dark:border-line-dark text-text-light-dim dark:text-text-dark-dim">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</div>
