---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../data/profile";
---

<header class="max-w-3xl mx-auto px-6 pt-8 flex items-center justify-between">
  <a
    href="/"
    class="font-display font-bold text-base tracking-tight hover:text-signal-dim dark:hover:text-signal transition-colors"
  >
    {SITE.name}
  </a>
  <nav class="flex items-center gap-3 sm:gap-5 font-mono text-xs uppercase tracking-wider">
    <a href="/#projects" class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Projects</a>
    <a href="/#work" class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Work</a>
    <a href="/#skills" class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Skills</a>
    <a href="/#contact" class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Contact</a>
    <a href="/blog" class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Writing</a>
    <ThemeToggle />
  </nav>
</header>
