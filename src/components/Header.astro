---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../data/profile";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="max-w-3xl mx-auto px-6 pt-8 flex items-center justify-between">
  <a
    href={base}
    class="font-display font-bold text-base tracking-tight hover:text-signal-dim dark:hover:text-signal transition-colors"
  >
    {SITE.name}
  </a>
  <nav class="flex items-center gap-3 sm:gap-5 font-mono text-xs uppercase tracking-wider">
    <a href={`${base}#projects`} class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Projects</a>
    <a href={`${base}#work`} class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Work</a>
    <a href={`${base}#skills`} class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Skills</a>
    <a href={`${base}#contact`} class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Contact</a>
    <a href={`${base}blog`} class="text-text-light-dim dark:text-text-dark-dim hover:text-signal-dim dark:hover:text-signal transition-colors">Writing</a>
    <ThemeToggle />
  </nav>
</header>
