---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
}

const {
  title,
  description = "Portfolio and technical writing.",
  ogImage,
  article = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const imagePath = ogImage
  ? `${base}${ogImage.replace(/^\//, "")}`
  : `${base}og-default.png`;

const resolvedOgImage = new URL(imagePath, Astro.site);

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={title}
      href={new URL(`${base}rss.xml`, Astro.site)}
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph — used by LinkedIn, WhatsApp, Slack link previews -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Theme is applied before paint to avoid a flash of the wrong mode -->
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches;
      const theme = stored ?? (prefersDark ? "dark" : "dark");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>

    <!-- Umami analytics — privacy-friendly, no cookie banner needed.
         Only loads once PUBLIC_UMAMI_WEBSITE_ID is set. -->
    {
      umamiWebsiteId && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={umamiWebsiteId}
        />
      )
    }
  </head>
  <body class="font-body bg-paper text-text-light dark:bg-ink dark:text-text-dark min-h-screen">
    <slot />
  </body>
</html>
