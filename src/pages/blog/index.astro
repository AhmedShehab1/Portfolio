---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { SITE } from "../../data/profile";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title={`Writing — ${SITE.name}`}
  description="Technical articles and notes on backend engineering, security, and infra."
>
  <Header />

  <main class="max-w-3xl mx-auto px-6">
    <section class="pt-16 pb-6">
      <h1 class="font-display font-bold text-3xl tracking-tight">Writing</h1>
      <p class="mt-3 text-text-light-dim dark:text-text-dark-dim">
        Notes from the learning journey — mostly backend, security, and infra.
      </p>
    </section>

    <section class="py-6">
      {
        posts.length > 0 ? (
          posts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              slug={post.id}
            />
          ))
        ) : (
          <p class="py-6 text-sm text-text-light-dim dark:text-text-dark-dim">
            Nothing published yet — add a post to src/content/blog.
          </p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>
