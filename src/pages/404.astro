---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="404 — Not found" description="Page not found.">
  <Header />
  <main class="max-w-3xl mx-auto px-6 pt-24 pb-16 text-center">
    <p class="font-mono text-xs uppercase tracking-wider text-signal-dim dark:text-signal">
      error 404
    </p>
    <h1 class="mt-3 font-display font-bold text-3xl">Nothing here.</h1>
    <p class="mt-3 text-text-light-dim dark:text-text-dark-dim">
      The page you're looking for doesn't exist.
    </p>
    <a href="/" class="mt-6 inline-block font-mono text-sm text-signal-dim dark:text-signal hover:underline">
      ← back home
    </a>
  </main>
  <Footer />
</Layout>
